NODE_ENV=development
PORT=5000

# PostgreSQL (local, Neon, Supabase, Railway...)
DATABASE_URL="postgresql://postgres:password@localhost:5432/amader_agency?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/amader_agency?schema=public"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Frontend (Next.js) URL. Extra allowed origins can go in CORS_ORIGINS (comma separated)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# Cookie settings. Production example: COOKIE_DOMAIN=.amaderagency.com, COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Shared secret between this API and the Next.js /api/revalidate route (min 16 chars)
REVALIDATE_SECRET=

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (lead notification emails). Leave empty to skip emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Amader Agency <no-reply@amaderagency.com>"
LEAD_NOTIFY_EMAIL=

# Used only by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@amaderagency.com
SEED_ADMIN_PASSWORD=
