# Keep development mode when running the production database locally.
NODE_ENV=development
# Labels this connection as production in logs and the admin system endpoint.
DB_LABEL=production
# Neon pooled connection string for local application traffic.
DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<database>?sslmode=require
# Neon direct connection string for Prisma migrations and administrative operations.
DIRECT_URL=postgresql://<user>:<password>@<neon-direct-host>/<database>?sslmode=require
# Local-only JWT secret; use a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT lifetime in days.
JWT_EXPIRES_DAYS=7
# Production frontend origin.
FRONTEND_URL=https://<production-frontend-url>
# Allow the local frontend to access the local backend.
CORS_ORIGINS=http://localhost:3000
# Leave empty so localhost cookies are not scoped to the production domain.
COOKIE_DOMAIN=
# Use lax cookie behavior for local development.
COOKIE_SAMESITE=lax
# Must match the value configured on Vercel.
REVALIDATE_SECRET=replace-with-the-vercel-revalidate-secret
# Optional Cloudinary image storage configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional SMTP email configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LEAD_NOTIFY_EMAIL=
